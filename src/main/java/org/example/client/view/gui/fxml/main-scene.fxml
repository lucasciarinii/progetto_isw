<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.client.view.gui.controller.FxController"
      spacing="10" alignment="CENTER">

    <Label text="Client GUI" />

    <TextField fx:id="nicknameField" promptText="Nickname" />
    <TextField fx:id="numPlayersField" promptText="Players number (2-5)" />

    <Button text="Connect" onAction="#onConnect"/>
</VBox>