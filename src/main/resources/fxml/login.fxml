<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Login screen with three mutually exclusive panels layered on top of each other:
    - menuPanel -> initial menu with Create/Join choices
    - createPanel -> form used to create a new lobby
    - joinPanel -> form used to join an existing lobby

    Connected controller:
    - GUILoginController

    Panels are shown/hidden at runtime through showPanel(...)
-->
<StackPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="it.polimi.ingsw.client.view.GUI.GUIController.GUILoginController"
        prefWidth="1376" prefHeight="768">

    <!-- Background image -->
    <ImageView fitWidth="1376" fitHeight="768">
        <Image url="@/images/login_BG.png"/>
    </ImageView>

    <!-- Dark overlay for readability -->
    <StackPane style="-fx-background-color: rgba(0,0,0,0.45);"/>

    <!-- Initial menu panel.
         Visible at startup; lets the user choose between lobby creation and lobby join
    -->
    <VBox fx:id="menuPanel"
          alignment="CENTER" spacing="32"
          style="-fx-padding: 180 0 0 0;">

        <!-- Two clickable cards used as entry points to the two login flows -->
        <HBox spacing="40" alignment="CENTER">

            <!-- Card: join an existing lobby -->
            <VBox
                  alignment="CENTER" spacing="12"
                  prefWidth="340" prefHeight="220"
                  onMouseClicked="#onJoinSelected"
                  style="-fx-background-color: #1a1a10;
                         -fx-border-color: #44cc44;
                         -fx-border-width: 2.5;
                         -fx-border-radius: 12;
                         -fx-background-radius: 12;
                         -fx-cursor: hand;
                         -fx-padding: 36 20 36 20;">
                <Label text="JOIN LOBBY"
                       style="-fx-text-fill: #f0e0b0;
                              -fx-font-size: 22px;
                              -fx-font-weight: bold;"/>
                <Label text="Enter with a game code"
                       style="-fx-text-fill: #888866;
                              -fx-font-size: 12px;"/>
            </VBox>

            <!-- Card: create a new lobby -->
            <VBox
                  alignment="CENTER" spacing="12"
                  prefWidth="340" prefHeight="220"
                  onMouseClicked="#onCreateSelected"
                  style="-fx-background-color: #1a1a10;
                         -fx-border-color: #ffcc00;
                         -fx-border-width: 2.5;
                         -fx-border-radius: 12;
                         -fx-background-radius: 12;
                         -fx-cursor: hand;
                         -fx-padding: 36 20 36 20;">
                <Label text="CREATE LOBBY"
                       style="-fx-text-fill: #ffcc00;
                              -fx-font-size: 22px;
                              -fx-font-weight: bold;"/>
                <Label text="Start a new match"
                       style="-fx-text-fill: #888866;
                              -fx-font-size: 12px;"/>
            </VBox>

        </HBox>
    </VBox>

    <!-- Lobby creation panel.
         Hidden by default and shown when the user selects the create-lobby flow
    -->
    <VBox fx:id="createPanel"
          alignment="CENTER" spacing="14"
          visible="false" managed="false"
          style="-fx-padding: 160 0 0 0;">

        <Label text="CREATE A NEW LOBBY"
               style="-fx-text-fill: #ffcc00;
                      -fx-font-size: 16px;
                      -fx-font-weight: bold;"/>

        <!-- Input group: nickname used for the new lobby -->
        <VBox spacing="5" maxWidth="320" style="-fx-fill-width: true;">
            <Label text="NICKNAME"
                   style="-fx-text-fill: #888866;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;"/>
            <TextField fx:id="createNicknameField"
                       promptText="Enter your nickname"
                       prefWidth="320"
                       style="-fx-background-color: #1a1a10;
                              -fx-border-color: #3a3a22;
                              -fx-border-width: 1;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-text-fill: #f0e0b0;
                              -fx-prompt-text-fill: #555544;
                              -fx-font-size: 13px;
                              -fx-padding: 9 14 9 14;"/>
        </VBox>

        <!-- Input group: required number of players for the new match -->
        <VBox spacing="5" maxWidth="320" style="-fx-fill-width: true;">
            <Label text="NUMBER OF PLAYERS  (2–5)"
                   style="-fx-text-fill: #888866;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;"/>
            <TextField fx:id="createNumPlayersField"
                       promptText="Enter number of players (2-5)"
                       prefWidth="320"
                       style="-fx-background-color: #1a1a10;
                              -fx-border-color: #3a3a22;
                              -fx-border-width: 1;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-text-fill: #f0e0b0;
                              -fx-prompt-text-fill: #555544;
                              -fx-font-size: 13px;
                              -fx-padding: 9 14 9 14;"/>
        </VBox>

        <!-- Action button: validates the form and asks the controller to create the lobby -->
        <Button text="CREATE LOBBY"
                onAction="#onCreateLobby"
                prefWidth="320"
                style="-fx-background-color: #ffcc00;
                       -fx-text-fill: #12120c;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;
                       -fx-background-radius: 6;
                       -fx-border-radius: 6;
                       -fx-padding: 10 0 10 0;
                       -fx-cursor: hand;"/>

        <!-- Validation / connection feedback for the create-lobby flow -->
        <Label fx:id="createErrorLabel"
               visible="false" managed="false" minHeight="14"
               style="-fx-text-fill: #cc4444; -fx-font-size: 11px;"/>

        <!-- Returns to the initial menu panel -->
        <Label text="← Back"
               onMouseClicked="#onBack"
               style="-fx-text-fill: #888866;
                      -fx-font-size: 11px;
                      -fx-cursor: hand;"/>
    </VBox>

    <!-- Lobby join panel.
         Hidden by default and shown when the user selects the join-lobby flow
    -->
    <VBox fx:id="joinPanel"
          alignment="CENTER" spacing="14"
          visible="false" managed="false"
          style="-fx-padding: 160 0 0 0;">

        <Label text="JOIN AN EXISTING LOBBY"
               style="-fx-text-fill: #f0e0b0;
                      -fx-font-size: 16px;
                      -fx-font-weight: bold;"/>

        <!-- Input group: game code of the lobby to join -->
        <VBox spacing="5" maxWidth="320" style="-fx-fill-width: true;">
            <Label text="GAME CODE"
                   style="-fx-text-fill: #888866;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;"/>
            <TextField fx:id="joinCodeField"
                       promptText="Enter the game code"
                       prefWidth="320"
                       style="-fx-background-color: #1a1a10;
                              -fx-border-color: #3a3a22;
                              -fx-border-width: 1;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-text-fill: #f0e0b0;
                              -fx-prompt-text-fill: #555544;
                              -fx-font-size: 13px;
                              -fx-padding: 9 14 9 14;"/>
        </VBox>

        <!-- Input group: nickname used to enter the selected lobby -->
        <VBox spacing="5" maxWidth="320" style="-fx-fill-width: true;">
            <Label text="NICKNAME"
                   style="-fx-text-fill: #888866;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;"/>
            <TextField fx:id="joinNicknameField"
                       promptText="Enter your nickname"
                       prefWidth="320"
                       style="-fx-background-color: #1a1a10;
                              -fx-border-color: #3a3a22;
                              -fx-border-width: 1;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-text-fill: #f0e0b0;
                              -fx-prompt-text-fill: #555544;
                              -fx-font-size: 13px;
                              -fx-padding: 9 14 9 14;"/>
        </VBox>

        <!-- Action button: validates the form and asks the controller to join the lobby -->
        <Button text="JOIN LOBBY"
                onAction="#onJoinLobby"
                prefWidth="320"
                style="-fx-background-color: #1a1a10;
                       -fx-text-fill: #f0e0b0;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;
                       -fx-background-radius: 6;
                       -fx-border-radius: 6;
                       -fx-border-color: #44cc44;
                       -fx-border-width: 1.5;
                       -fx-padding: 10 0 10 0;
                       -fx-cursor: hand;"/>

        <!-- Validation / connection feedback for the join-lobby flow -->
        <Label fx:id="joinErrorLabel"
               visible="false" managed="false" minHeight="14"
               style="-fx-text-fill: #cc4444; -fx-font-size: 11px;"/>

        <!-- Returns to the initial menu panel -->
        <Label text="← Back"
               onMouseClicked="#onBack"
               style="-fx-text-fill: #888866;
                      -fx-font-size: 11px;
                      -fx-cursor: hand;"/>
    </VBox>

</StackPane>