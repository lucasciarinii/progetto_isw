<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Main game screen for the MESOS GUI.
-->
<StackPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.client.view.GUI.GUIController.GUIGameController"
        prefWidth="1376" prefHeight="768">

    <!-- Fullscreen background image -->
    <ImageView fx:id="bgImageView"
               preserveRatio="false"
               mouseTransparent="true">
        <image>
            <Image url="@/images/game_BG.png"/>
        </image>
    </ImageView>

    <!-- Foreground layout -->
    <BorderPane prefWidth="1376" prefHeight="768"
                style="-fx-background-color: transparent;">

        <!-- Floating top-left compact information panel -->
        <top>
            <VBox style="-fx-background-color: transparent; -fx-padding: 12 0 0 12;">
                <VBox maxWidth="520"
                      spacing="4"
                      style="-fx-background-color: rgba(42,36,24,0.62);
                             -fx-background-radius: 18;
                             -fx-border-color: rgba(132,112,72,0.60);
                             -fx-border-radius: 18;
                             -fx-border-width: 1;
                             -fx-padding: 8 14 8 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.20), 10, 0, 0, 2);">

                    <!-- Game info row -->
                    <HBox spacing="10"
                          style="-fx-alignment: center-left;">

                        <Label text="ROUND"
                               style="-fx-text-fill: #7d7458;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="roundLabel"
                               style="-fx-text-fill: #f0e0b0;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>

                        <Label text="•" style="-fx-text-fill: #4a4330;"/>

                        <Label text="ERA"
                               style="-fx-text-fill: #7d7458;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="eraLabel"
                               style="-fx-text-fill: #f0e0b0;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>

                        <Label text="•" style="-fx-text-fill: #4a4330;"/>

                        <Label text="PHASE"
                               style="-fx-text-fill: #7d7458;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="phaseLabel"
                               style="-fx-text-fill: #f0e0b0;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>

                        <Label text="•" style="-fx-text-fill: #4a4330;"/>

                        <Label text="TURN"
                               style="-fx-text-fill: #7d7458;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="currentPlayerLabel"
                               style="-fx-text-fill: #ffcc00;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Status + confirm row -->
                    <HBox spacing="10"
                          style="-fx-alignment: center-left;">
                        <Label fx:id="statusLabel"
                               text="Waiting..."
                               style="-fx-text-fill: #d8c78f;
                                      -fx-font-size: 11px;"/>

                        <Button fx:id="confirmButton"
                                text="CONFIRM"
                                onAction="#onConfirm"
                                visible="false"
                                managed="false"
                                style="-fx-background-color: linear-gradient(to bottom, #3f9a63, #2d7a4f);
                                       -fx-text-fill: #f7fff8;
                                       -fx-font-weight: bold;
                                       -fx-font-size: 11px;
                                       -fx-padding: 5 14 5 14;
                                       -fx-background-radius: 12;
                                       -fx-border-radius: 12;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </top>

        <!-- Central board area -->
        <center>
            <ScrollPane fitToWidth="true"
                        fitToHeight="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        style="-fx-background: transparent;
                               -fx-background-color: transparent;
                               -fx-border-color: transparent;">

                <VBox style="-fx-alignment: center;
                             -fx-background-color: transparent;"
                      spacing="0">

                    <VBox spacing="10"
                          style="-fx-padding: 18 20 18 20;
                                 -fx-alignment: center;
                                 -fx-background-color: transparent;">

                        <!-- Top row cards -->
                        <HBox fx:id="topRowBox"
                              spacing="6"
                              style="-fx-alignment: center;"/>

                        <!-- Middle row: deck + turn order + offer track -->
                        <HBox spacing="20"
                              style="-fx-alignment: center; -fx-padding: 4 0 4 0;">

                            <ImageView fx:id="deckBackView"
                                       fitWidth="120"
                                       fitHeight="180"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 8, 0, 0, 3);"/>

                            <HBox fx:id="turnSlotBox"
                                  style="-fx-alignment: center;"/>

                            <HBox fx:id="offerTrackBox"
                                  spacing="6"
                                  style="-fx-alignment: center;"/>
                        </HBox>

                        <!-- Bottom row cards -->
                        <HBox fx:id="bottomRowBox"
                              spacing="6"
                              style="-fx-alignment: center;"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>

        <!-- Right opponents panel -->
        <right>
            <VBox style="-fx-background-color: transparent; -fx-padding: 12 12 12 0;">
                <VBox prefWidth="270"
                      style="-fx-background-color: rgba(44,38,26,0.58);
                             -fx-background-radius: 18;
                             -fx-border-color: rgba(132,112,72,0.55);
                             -fx-border-radius: 18;
                             -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 10, 0, 0, 2);">

                    <Label text="OPPONENTS"
                           style="-fx-text-fill: #7d7458;
                                  -fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 10 0 6 14;"/>

                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                style="-fx-background: transparent;
                                       -fx-background-color: transparent;
                                       -fx-border-color: transparent;"
                                VBox.vgrow="ALWAYS">
                        <VBox fx:id="opponentsBox"
                              spacing="8"
                              style="-fx-padding: 4 10 14 10;
                                     -fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </right>

        <!-- Bottom local player panel -->
        <bottom>
            <VBox style="-fx-background-color: transparent; -fx-padding: 0 12 10 12;">
                <VBox style="-fx-background-color: rgba(44,38,26,0.62);
                             -fx-background-radius: 18 18 0 0;
                             -fx-border-color: rgba(132,112,72,0.55);
                             -fx-border-radius: 18 18 0 0;
                             -fx-border-width: 1;
                             -fx-padding: 0 0 4 0;">

                    <Label text="YOUR TRIBE"
                           style="-fx-text-fill: #7d7458;
                                  -fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 6 0 2 14;"/>

                    <ScrollPane fitToWidth="true"
                                hbarPolicy="AS_NEEDED"
                                vbarPolicy="NEVER"
                                prefHeight="180"
                                style="-fx-background: transparent;
                                       -fx-background-color: transparent;
                                       -fx-border-color: transparent;
                                       -fx-background-insets: 0;">
                        <HBox fx:id="localPlayerBox"
                              spacing="8"
                              style="-fx-padding: 4 12 4 12;
                                     -fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </bottom>

    </BorderPane>

</StackPane>