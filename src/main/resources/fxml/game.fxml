<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Main game screen for the MESOS GUI.

    Connected controller:
    - GUIGameController

    Main dynamic areas populated/updated at runtime:
    - roundLabel / eraLabel / phaseLabel / currentPlayerLabel
    - statusLabel / confirmButton
    - topRowBox / bottomRowBox
    - offerTrackBox / turnSlotBox
    - opponentsBox / localPlayerBox
-->
<StackPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="it.polimi.ingsw.client.view.GUI.GUIController.GUIGameController"
        prefWidth="1376" prefHeight="768">

    <!-- Fullscreen background image -->
    <ImageView fx:id="bgImageView" mouseTransparent="true">
        <Image url="@/images/game_BG.png"/>
    </ImageView>

    <!-- Main foreground layout split into top info bar, center board, right opponents panel, and bottom local-player panel -->
    <BorderPane prefWidth="1376" prefHeight="768" style="-fx-background-color: transparent;">

        <!-- Top floating info area with match data, status messages, and confirm action -->
        <top>
            <VBox style="-fx-background-color: transparent; -fx-padding: 12 0 0 12;">
                <!-- Semi-transparent compact info panel shown above the board -->
                <VBox maxWidth="520"
                      spacing="4"
                      style="-fx-background-color: rgba(42,36,24,0.62);
                             -fx-background-radius: 18;
                             -fx-border-color: rgba(132,112,72,0.60);
                             -fx-border-radius: 18;
                             -fx-border-width: 1;
                             -fx-padding: 8 14 8 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.20), 10, 0, 0, 2);">

                    <!-- Game info row -->
                    <HBox spacing="10"
                          style="-fx-alignment: center-left;">

                        <Label text="ROUND"
                               style="-fx-text-fill: #7d7458;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="roundLabel"
                               style="-fx-text-fill: #f0e0b0;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>

                        <Label text="•" style="-fx-text-fill: #4a4330;"/>

                        <Label text="ERA"
                               style="-fx-text-fill: #7d7458;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="eraLabel"
                               style="-fx-text-fill: #f0e0b0;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>

                        <Label text="•" style="-fx-text-fill: #4a4330;"/>

                        <Label text="PHASE"
                               style="-fx-text-fill: #7d7458;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="phaseLabel"
                               style="-fx-text-fill: #f0e0b0;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>

                        <Label text="•" style="-fx-text-fill: #4a4330;"/>

                        <Label text="TURN"
                               style="-fx-text-fill: #7d7458;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="currentPlayerLabel"
                               style="-fx-text-fill: #ffcc00;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Status data + confirm button -->
                    <HBox spacing="10"
                          style="-fx-alignment: center-left;">
                        <Label fx:id="statusLabel"
                               text="Waiting..."
                               style="-fx-text-fill: #d8c78f;
                                      -fx-font-size: 11px;"/>

                        <!-- Hidden by default; shown only when the current selection can be confirmed -->
                        <Button fx:id="confirmButton"
                                text="CONFIRM"
                                onAction="#onConfirm"
                                visible="false"
                                managed="false"
                                style="-fx-background-color: linear-gradient(to bottom, #3f9a63, #2d7a4f);
                                       -fx-text-fill: #f7fff8;
                                       -fx-font-weight: bold;
                                       -fx-font-size: 11px;
                                       -fx-padding: 5 14 5 14;
                                       -fx-background-radius: 12;
                                       -fx-border-radius: 12;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </top>

        <!-- Central board area containing the two card rows, deck, turn order, and offer track -->
        <center>
            <!-- Scrollable board container to keep the main play area centered and accessible on smaller windows -->
            <ScrollPane fitToWidth="true"
                        fitToHeight="true"
                        hbarPolicy="NEVER"
                        style="-fx-background: transparent;
                               -fx-background-color: transparent;
                               -fx-border-color: transparent;">

                <VBox style="-fx-alignment: center;
                             -fx-background-color: transparent;">
                    <!-- Main board layout assembled vertically: top row, middle row, bottom row -->
                    <VBox spacing="10"
                          style="-fx-padding: 18 20 18 20;
                                 -fx-alignment: center;
                                 -fx-background-color: transparent;">

                        <!-- Top row cards -->
                        <HBox fx:id="topRowBox"
                              spacing="6"
                              style="-fx-alignment: center;"/>

                        <!-- Middle row: deck + turn order + offer track -->
                        <HBox spacing="20"
                              style="-fx-alignment: center; -fx-padding: 4 0 4 0;">

                            <!-- Deck-back image updated according to the current era/round (to simulate the deck presence) -->
                            <ImageView fx:id="deckBackView"
                                       fitWidth="120"
                                       fitHeight="180"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 8, 0, 0, 3);"/>

                            <!-- Container for the custom TurnSlotView component -->
                            <HBox fx:id="turnSlotBox"
                                  style="-fx-alignment: center;"/>

                            <!-- Container for the runtime-generated offer-track tile views -->
                            <HBox fx:id="offerTrackBox"
                                  spacing="6"
                                  style="-fx-alignment: center;"/>
                        </HBox>

                        <!-- Bottom row cards -->
                        <HBox fx:id="bottomRowBox"
                              spacing="6"
                              style="-fx-alignment: center;"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>

        <!-- Right-side panel listing all opponent tribes and their current public state -->
        <right>
            <VBox style="-fx-background-color: transparent; -fx-padding: 12 12 12 0;">
                <!-- Semi-transparent sidebar containing the scrollable list of opponent panels -->
                <VBox prefWidth="270"
                      style="-fx-background-color: rgba(44,38,26,0.58);
                             -fx-background-radius: 18;
                             -fx-border-color: rgba(132,112,72,0.55);
                             -fx-border-radius: 18;
                             -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 10, 0, 0, 2);">

                    <Label text="OPPONENTS"
                           style="-fx-text-fill: #7d7458;
                                  -fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 10 0 6 14;"/>

                    <!-- Scroll container for dynamically created opponent player panels -->
                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                style="-fx-background: transparent;
                                       -fx-background-color: transparent;
                                       -fx-border-color: transparent;"
                                VBox.vgrow="ALWAYS">

                        <!-- Runtime-filled container of PlayerPanelView components for opponents -->
                        <VBox fx:id="opponentsBox"
                              spacing="8"
                              style="-fx-padding: 4 10 14 10;
                                     -fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </right>

        <!-- Bottom panel dedicated to the local player's owned cards -->
        <bottom>
            <VBox style="-fx-background-color: transparent; -fx-padding: 0 12 10 12;">
                <!-- Semi-transparent container for the local player's panel -->
                <VBox style="-fx-background-color: rgba(44,38,26,0.62);
                             -fx-background-radius: 18 18 0 0;
                             -fx-border-color: rgba(132,112,72,0.55);
                             -fx-border-radius: 18 18 0 0;
                             -fx-border-width: 1;
                             -fx-padding: 0 0 4 0;">

                    <Label text="YOUR TRIBE"
                           style="-fx-text-fill: #7d7458;
                                  -fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 6 0 2 14;"/>

                    <!-- Horizontal container used to host the local player's PlayerPanelView -->
                    <ScrollPane fitToWidth="true"
                                vbarPolicy="NEVER"
                                prefHeight="180"
                                style="-fx-background: transparent;
                                       -fx-background-color: transparent;
                                       -fx-border-color: transparent;
                                       -fx-background-insets: 0;">

                        <!-- Runtime-filled container holding the local player's panel -->
                        <HBox fx:id="localPlayerBox"
                              spacing="8"
                              style="-fx-padding: 4 12 4 12;
                                     -fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </bottom>

    </BorderPane>

</StackPane>